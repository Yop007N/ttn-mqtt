# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ttn_mqtt
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_LOGGING=false

# Database Pool Configuration
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# MQTT Configuration - The Things Network
MQTT_HOST=au1.cloud.thethings.network
MQTT_PORT=1883
MQTT_USERNAME=your-ttn-application-id
MQTT_PASSWORD=your-ttn-api-key
MQTT_TOPICS=v3/+/devices/+/up,v3/+/devices/+/down
MQTT_CLIENT_ID=ttn-mqtt-gateway
MQTT_RECONNECT_PERIOD=5000
MQTT_CONNECT_TIMEOUT=30000
MQTT_KEEPALIVE=60
MQTT_QOS=1

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ROTATION=true
LOG_MAX_FILES=5
LOG_MAX_SIZE=20m

# Health Check Configuration
HEALTH_ENDPOINT=/health
HEALTH_TIMEOUT=5000

# Metrics Configuration
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics